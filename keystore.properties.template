# Copy this file to keystore.properties and fill in your production keystore details.
# NEVER commit keystore.properties or your .jks/.keystore file to version control.
#
# To create a production keystore:
#   keytool -genkey -v -keystore habitharmony-release.jks \
#     -alias habitharmony -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the values below:

storeFile=../habitharmony-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=habitharmony
keyPassword=YOUR_KEY_PASSWORD
