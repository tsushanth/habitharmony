<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) data extraction rules.
    Excludes premium/settings SharedPreferences from cloud backup and device-to-device
    transfer to prevent premium state from being restored to a fresh install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="premium_prefs.xml" />
        <exclude domain="sharedpref" path="settings_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="premium_prefs.xml" />
        <exclude domain="sharedpref" path="settings_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
